rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function userDoc(uid)    { return /databases/$(database)/documents/users/$(uid); }
    function inviteDoc(code) { return /databases/$(database)/documents/invites/$(code); }
    function coupleDoc(id)   { return /databases/$(database)/documents/couples/$(id); }

    // 커플 문서 id는 두 uid를 사전순으로 정렬해 "_"로 이은 값이다.
    // 결정적 id 덕분에 문서 id와 memberIds의 일치를 여기서 검증할 수 있다.
    function coupleIdOf(a, b) {
      return a < b ? a + '_' + b : b + '_' + a;
    }

    // coupleId 키가 아예 없는 문서에서도 규칙이 오류로 죽지 않게 한다.
    function unpaired(uid) {
      let data = get(userDoc(uid)).data;
      return !('coupleId' in data) || data.coupleId == null;
    }

    // 초대 코드가 유효하고, 발급자가 상대이며, 양쪽 모두 미연결인가. (PRD 9)
    function pairingAllowed(code, inviterUid) {
      return exists(inviteDoc(code))
        && get(inviteDoc(code)).data.inviterUid == inviterUid
        && get(inviteDoc(code)).data.expiresAt > request.time
        && unpaired(inviterUid)
        && unpaired(request.auth.uid);
    }

    // 초대 코드 — 코드 자체가 비밀이다. 단건 조회만 열고 목록 조회는 막는다.
    // (list를 열면 코드 전수 조회가 가능해진다)
    match /invites/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.inviterUid == request.auth.uid
        && request.resource.data.expiresAt > request.time
        && request.resource.data.keys().hasOnly(
             ['inviterUid', 'inviterName', 'createdAt', 'expiresAt']
           );
      // 수정 개념이 없다. 겹친 코드에 set을 하면 여기서 막혀 재발급으로 이어진다.
      allow update: if false;
      // 발급자의 회수 + 수락자의 소진. 남아 있어도 pairingAllowed가 재사용을 막는다.
      allow delete: if signedIn();
    }

    // 개인(미연결) 데이터 — 본인만 read/write.
    // users/{uid}/expenses|schedules|todos|ddays|budget 이 여기에 걸린다.
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // 연결 성사 순간에만, 상대가 내 coupleId "한 필드"를 채우는 것을 허용한다.
      // getAfter를 쓰는 이유 — 커플 문서는 같은 배치에서 만들어져서 get(커밋 전 상태)으론
      // 보이지 않는다. 이 한 가지가 서버 없이 원자성을 강제하는 지점이다.
      allow update: if signedIn()
        && (!('coupleId' in resource.data) || resource.data.coupleId == null)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['coupleId'])
        && request.resource.data.coupleId != null
        && userId in getAfter(coupleDoc(request.resource.data.coupleId)).data.memberIds
        && request.auth.uid in getAfter(coupleDoc(request.resource.data.coupleId)).data.memberIds;

      match /{document=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // 공동(연결) 데이터 — memberIds에 포함된 uid만 접근. (PRD 9. 상대방 연결)
    match /couples/{coupleId} {
      function couple() {
        return get(coupleDoc(coupleId)).data;
      }
      function isMember() {
        return signedIn() && request.auth.uid in couple().memberIds;
      }
      // deletedAt이 있으면 연결 해제/탈퇴 유예기간 중 → 열람만 허용, 신규 쓰기 차단.
      function notDeleted() {
        return couple().deletedAt == null;
      }
      function partnerOf(ids) {
        return ids[0] == request.auth.uid ? ids[1] : ids[0];
      }

      allow get, list: if signedIn() && request.auth.uid in resource.data.memberIds;

      // 연결 성사.
      allow create: if signedIn()
        && request.resource.data.memberIds.size() == 2
        && request.auth.uid in request.resource.data.memberIds
        // 자기 코드로 자기 자신과 연결하는 것을 막는다 (memberIds: [B, B])
        && partnerOf(request.resource.data.memberIds) != request.auth.uid
        && coupleId == coupleIdOf(request.resource.data.memberIds[0],
                                  request.resource.data.memberIds[1])
        && request.resource.data.deletedAt == null
        && pairingAllowed(request.resource.data.inviteCode,
                          partnerOf(request.resource.data.memberIds));

      allow update: if isMember() && notDeleted();
      // 해제는 삭제가 아니라 deletedAt 마킹으로 한다 (PRD 9. 30일 유예).
      allow delete: if false;

      match /{document=**} {
        allow read: if isMember();
        allow write: if isMember() && notDeleted();
      }
    }
  }
}
